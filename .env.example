# Public Firebase Web App configuration (not service-account credentials).
# Copy to .env.local and fill these values from Firebase Project Settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Set to "demo" to force the local demo catalog. Default: try Firestore when configured.
VITE_CATALOG_MODE=demo

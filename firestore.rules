rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function categoryIsActive(categoryId) {
      return categoryId is string
        && exists(/databases/$(database)/documents/categories/$(categoryId))
        && get(/databases/$(database)/documents/categories/$(categoryId)).data.active == true;
    }

    match /categories/{categoryId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    match /artworks/{artworkId} {
      // Public catalog query reads every explicitly published artwork, then the
      // storefront limits visible items to its separately published categories.
      // Firestore rules are not filters: requiring a dynamic category lookup here
      // rejects the storefront's collection-wide active == true query.
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    match /covers/{coverId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    // Artwork previews live in separate documents so public catalog queries
    // never download image payloads. Only direct reads for active parent records
    // are public; drafts and collection listing remain admin-only.
    match /catalogAssets/{assetId} {
      allow get: if isAdmin() || (
        resource != null && (
          (resource.data.assetType == 'artwork'
            && resource.data.itemId is string
            && exists(/databases/$(database)/documents/artworks/$(resource.data.itemId))
            && get(/databases/$(database)/documents/artworks/$(resource.data.itemId)).data.active == true)
          || (resource.data.assetType == 'cover'
            && resource.data.itemId is string
            && exists(/databases/$(database)/documents/covers/$(resource.data.itemId))
            && get(/databases/$(database)/documents/covers/$(resource.data.itemId)).data.active == true)
        )
      );
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /settings/public {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // Partner applications: the signed-in applicant may create exactly one
    // application at their own UID and read only their own status.
    // Approval and partner profile creation are admin-only.
    match /partnerApplications/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'whatsapp', 'social', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'name', 'whatsapp', 'social', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.matches('^20[0-9]{10}$')
        && request.resource.data.social is string
        && request.resource.data.social.size() >= 2
        && request.resource.data.social.size() <= 250
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow read: if isAdmin() || isOwner(uid);
      allow update, delete: if isAdmin();
    }

    // Approved partner profiles are created/updated only by trusted admins.
    match /partners/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create, update, delete: if isAdmin();
    }

    // Guest checkout creates only a constrained "new / awaiting review" request.
    // Customer clients cannot read, edit, delete, mark paid, or change fulfillment.
    // Price/offer attribution is still subject to admin review because no trusted
    // backend is available to validate the one-hour promo against server time.
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow create: if
        request.resource.data.keys().hasOnly([
          'publicReference', 'customer', 'shipping', 'book', 'pricing',
          'paymentMethod', 'paymentStatus', 'fulfillmentStatus', 'partnerCode', 'ambassadorReferralCode', 'ambassadorSetup', 'trackingToken',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'publicReference', 'customer', 'shipping', 'book', 'pricing',
          'paymentMethod', 'paymentStatus', 'fulfillmentStatus', 'trackingToken',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.publicReference is string
        && request.resource.data.publicReference.size() >= 6
        && request.resource.data.publicReference.size() <= 40
        && request.resource.data.trackingToken is string
        && request.resource.data.trackingToken.matches('^[a-f0-9]{64}$')
        && request.resource.data.customer is map
        && request.resource.data.customer.keys().hasOnly(['name', 'phone'])
        && request.resource.data.customer.name is string
        && request.resource.data.customer.name.size() >= 2
        && request.resource.data.customer.name.size() <= 80
        && request.resource.data.customer.phone is string
        && request.resource.data.customer.phone.size() >= 10
        && request.resource.data.customer.phone.size() <= 16
        && request.resource.data.shipping is map
        && request.resource.data.shipping.keys().hasOnly([
          'governorateName', 'areaName', 'address', 'deliveryNotes', 'fee'
        ])
        && request.resource.data.shipping.governorateName is string
        && request.resource.data.shipping.governorateName.size() >= 2
        && request.resource.data.shipping.governorateName.size() <= 60
        && request.resource.data.shipping.areaName is string
        && request.resource.data.shipping.areaName.size() >= 2
        && request.resource.data.shipping.areaName.size() <= 80
        && request.resource.data.shipping.address is string
        && request.resource.data.shipping.address.size() >= 5
        && request.resource.data.shipping.address.size() <= 300
        && request.resource.data.shipping.deliveryNotes is string
        && request.resource.data.shipping.deliveryNotes.size() <= 300
        && request.resource.data.shipping.fee is int
        && request.resource.data.shipping.fee == get(/databases/$(database)/documents/settings/public).data.shippingFee
        && request.resource.data.book is map
        && request.resource.data.book.keys().hasOnly(['artworks', 'cover', 'personalizedName'])
        && request.resource.data.book.artworks is list
        && request.resource.data.book.artworks.size() == 30
        && request.resource.data.book.cover is map
        && request.resource.data.book.cover.keys().hasOnly(['coverId', 'titleSnapshot'])
        && request.resource.data.book.cover.coverId is string
        && request.resource.data.book.cover.titleSnapshot is string
        && request.resource.data.book.personalizedName is string
        && request.resource.data.book.personalizedName.size() >= 1
        && request.resource.data.book.personalizedName.size() <= 40
        && request.resource.data.pricing is map
        && request.resource.data.pricing.keys().hasOnly([
          'currency', 'standardBookPrice', 'bookPrice', 'shippingFee',
          'totalAmount', 'offerApplied'
        ])
        && request.resource.data.pricing.currency == 'EGP'
        && request.resource.data.pricing.standardBookPrice == 240
        && request.resource.data.pricing.bookPrice in [190, 240]
        && request.resource.data.pricing.shippingFee is int
        && request.resource.data.pricing.shippingFee == get(/databases/$(database)/documents/settings/public).data.shippingFee
        && request.resource.data.pricing.totalAmount == request.resource.data.pricing.bookPrice + request.resource.data.pricing.shippingFee
        && request.resource.data.pricing.offerApplied is bool
        && request.resource.data.pricing.offerApplied == (request.resource.data.pricing.bookPrice == 190)
        && request.resource.data.paymentMethod in ['cod', 'instapay']
        && request.resource.data.paymentStatus in ['unpaid', 'pending_review']
        && request.resource.data.fulfillmentStatus == 'new'
        && (request.resource.data.partnerCode == null
          || (request.resource.data.partnerCode is string
            && request.resource.data.partnerCode.size() <= 40))
        && (!request.resource.data.keys().hasAny(['ambassadorReferralCode'])
          || request.resource.data.ambassadorReferralCode == null
          || (request.resource.data.ambassadorReferralCode is string
            && request.resource.data.ambassadorReferralCode.matches('^AP[A-F0-9]{20}$')))
        && (!request.resource.data.keys().hasAny(['ambassadorSetup'])
          || (request.resource.data.ambassadorSetup is map
            && request.resource.data.ambassadorSetup.keys().hasOnly(['code', 'accessTokenHash'])
            && request.resource.data.ambassadorSetup.keys().hasAll(['code', 'accessTokenHash'])
            && request.resource.data.ambassadorSetup.code is string
            && request.resource.data.ambassadorSetup.code.matches('^AP[A-F0-9]{20}$')
            && request.resource.data.ambassadorSetup.accessTokenHash is string
            && request.resource.data.ambassadorSetup.accessTokenHash.matches('^[a-f0-9]{64}$')))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update, delete: if isAdmin();
    }

    // Public bearer-token projection: contains status/reference only, never customer PII.
    match /orderTracking/{token} {
      allow get: if token.matches('^[a-f0-9]{64}$') && resource != null;
      allow list: if false;
      allow create: if token.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasOnly(['publicReference', 'fulfillmentStatus', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['publicReference', 'fulfillmentStatus', 'createdAt', 'updatedAt'])
        && request.resource.data.publicReference is string
        && request.resource.data.publicReference.size() >= 6
        && request.resource.data.publicReference.size() <= 40
        && request.resource.data.fulfillmentStatus == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update, delete: if isAdmin();
    }
    // Reward source records are admin-only. Customer portals use a 256-bit
    // bearer capability: SHA-256 of the private key as the document ID.
    match /ambassadors/{ambassadorCode} {
      allow read, write: if isAdmin();
    }
    match /ambassadorCommissions/{orderId} {
      allow read, write: if isAdmin();
    }
    match /ambassadorPayouts/{payoutId} {
      allow read: if isAdmin();
      allow create: if
        request.resource.data.keys().hasOnly(['ambassadorCode','accessTokenHash','amount','method','payoutDetails','status','requestedAt','reviewedAt','paidAt'])
        && request.resource.data.keys().hasAll(['ambassadorCode','accessTokenHash','amount','method','payoutDetails','status','requestedAt','reviewedAt','paidAt'])
        && request.resource.data.ambassadorCode is string
        && request.resource.data.ambassadorCode.matches('^AP[A-F0-9]{20}$')
        && request.resource.data.accessTokenHash is string
        && request.resource.data.accessTokenHash.matches('^[a-f0-9]{64}$')
        && exists(/databases/$(database)/documents/ambassadorPortals/$(request.resource.data.accessTokenHash))
        && get(/databases/$(database)/documents/ambassadorPortals/$(request.resource.data.accessTokenHash)).data.code == request.resource.data.ambassadorCode
        && get(/databases/$(database)/documents/ambassadorPortals/$(request.resource.data.accessTokenHash)).data.status == 'active'
        && request.resource.data.amount is int
        && request.resource.data.amount >= 50
        && request.resource.data.amount <= get(/databases/$(database)/documents/ambassadorPortals/$(request.resource.data.accessTokenHash)).data.availableBalance
        && request.resource.data.method in ['instapay','wallet']
        && request.resource.data.payoutDetails is string
        && request.resource.data.payoutDetails.size() >= 5
        && request.resource.data.payoutDetails.size() <= 120
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time
        && request.resource.data.reviewedAt == null
        && request.resource.data.paidAt == null
        && getAfter(/databases/$(database)/documents/ambassadorPortals/$(request.resource.data.accessTokenHash)).data.availableBalance
          == get(/databases/$(database)/documents/ambassadorPortals/$(request.resource.data.accessTokenHash)).data.availableBalance - request.resource.data.amount
        && getAfter(/databases/$(database)/documents/ambassadorPortals/$(request.resource.data.accessTokenHash)).data.reservedBalance
          == get(/databases/$(database)/documents/ambassadorPortals/$(request.resource.data.accessTokenHash)).data.reservedBalance + request.resource.data.amount
        && getAfter(/databases/$(database)/documents/ambassadorPortals/$(request.resource.data.accessTokenHash)).data.lastPayoutId == payoutId;
      allow update, delete: if isAdmin();
    }
    match /ambassadorPortals/{accessHash} {
      allow get: if isAdmin() || (accessHash.matches('^[a-f0-9]{64}$') && resource != null);
      allow list: if false;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        accessHash.matches('^[a-f0-9]{64}$')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availableBalance','reservedBalance','lastPayoutId','updatedAt'])
        && request.resource.data.availableBalance is int
        && request.resource.data.reservedBalance is int
        && request.resource.data.lastPayoutId is string
        && existsAfter(/databases/$(database)/documents/ambassadorPayouts/$(request.resource.data.lastPayoutId))
        && getAfter(/databases/$(database)/documents/ambassadorPayouts/$(request.resource.data.lastPayoutId)).data.accessTokenHash == accessHash
        && getAfter(/databases/$(database)/documents/ambassadorPayouts/$(request.resource.data.lastPayoutId)).data.amount
          == resource.data.availableBalance - request.resource.data.availableBalance
        && request.resource.data.availableBalance >= 0
        && request.resource.data.reservedBalance == resource.data.reservedBalance
          + getAfter(/databases/$(database)/documents/ambassadorPayouts/$(request.resource.data.lastPayoutId)).data.amount
      );
      match /commissions/{orderId} {
        allow read: if accessHash.matches('^[a-f0-9]{64}$');
        allow create, update, delete: if isAdmin();
      }
      match /payouts/{payoutId} {
        allow read: if accessHash.matches('^[a-f0-9]{64}$');
        allow create: if isAdmin() || (existsAfter(/databases/$(database)/documents/ambassadorPayouts/$(payoutId))
          && getAfter(/databases/$(database)/documents/ambassadorPayouts/$(payoutId)).data.accessTokenHash == accessHash
          && getAfter(/databases/$(database)/documents/ambassadorPayouts/$(payoutId)).data.status == 'pending'
          && request.resource.data.keys().hasOnly(['id','amount','method','status','requestedAt'])
          && request.resource.data.id == payoutId
          && request.resource.data.amount == getAfter(/databases/$(database)/documents/ambassadorPayouts/$(payoutId)).data.amount
          && request.resource.data.status == 'pending');
        allow update, delete: if isAdmin();
      }
    }
    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /orderEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /adminUsers/{uid} {
      allow read: if isAdmin() && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
